FROM ubuntu:noble

ENV DEBIAN_FRONTEND=noninteractive

# Pin a single matched LLVM/Clang version. Installing "clang" + "llvm" generically
# pulls in whatever the distro default is, and mixing that with dev/config packages
# from another version (or a second apt source) is what causes the
# find_package(LLVM CONFIG) / find_package(Clang CONFIG) mismatch errors -- so
# everything below is pinned to the same -18 release.
ARG LLVM_VERSION=18

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg lsb-release \
      git cmake ninja-build pkg-config patch \
      clang-${LLVM_VERSION} \
      libclang-${LLVM_VERSION}-dev \
      llvm-${LLVM_VERSION}-dev \
      libeigen3-dev \
      libcgal-dev \
      libfmt-dev \
      libcppad-dev \
      nlohmann-json3-dev \
      python3 python3-dev python3-pip \
    && rm -rf /var/lib/apt/lists/*

# pinocchio has no plain Ubuntu package; pull it from the robotpkg apt repo
# (Stack-Of-Tasks), which installs under /opt/openrobots.
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL http://robotpkg.openrobots.org/packages/debian/robotpkg.asc \
      -o /etc/apt/keyrings/robotpkg.asc && \
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/robotpkg.asc] http://robotpkg.openrobots.org/packages/debian/pub $(lsb_release -cs) robotpkg" \
      > /etc/apt/sources.list.d/robotpkg.list && \
    apt-get update && apt-get install -y --no-install-recommends robotpkg-pinocchio && \
    rm -rf /var/lib/apt/lists/*

# Unversioned symlinks so tools that shell out to plain "clang"/"llvm-config"
# (e.g. CppADCodeGen's bundled FindLLVM.cmake) find the pinned -18 toolchain too.
RUN ln -sf /usr/bin/clang-${LLVM_VERSION} /usr/bin/clang && \
    ln -sf /usr/bin/clang++-${LLVM_VERSION} /usr/bin/clang++ && \
    ln -sf /usr/bin/llvm-config-${LLVM_VERSION} /usr/bin/llvm-config

ENV CMAKE_PREFIX_PATH=/opt/openrobots
ENV CC=/usr/bin/clang-${LLVM_VERSION}
ENV CXX=/usr/bin/clang++-${LLVM_VERSION}

COPY . cricket/
WORKDIR /cricket
