  <disable_collisions link1="iiwa_left/iiwa_link_2" link2="iiwa_left/iiwa_link_3" reason="filtered" />
  <disable_collisions link1="iiwa_left/iiwa_link_3" link2="iiwa_left/iiwa_link_4" reason="filtered" />
