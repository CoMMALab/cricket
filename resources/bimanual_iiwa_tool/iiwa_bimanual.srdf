  <disable_collisions link1="iiwa_left/iiwa_link_7" link2="wsg_left/body" reason="filtered" />
  <disable_collisions link1="iiwa_left/iiwa_link_7" link2="wsg_left/left_finger" reason="filtered" />
  <disable_collisions link1="iiwa_left/iiwa_link_7" link2="wsg_left/right_finger" reason="filtered" />
