<?xml version="1.0"?>
<!-- iiwa_bimanual: link pairs (both with collision geometry) whose collisions
     Drake filters: adjacent and welded bodies plus the models' and
     directives' collision filter groups. Every other pair is checked.
     tests/test_external_models.py checks it against the Drake model. -->
<robot name="iiwa_bimanual">
  <disable_collisions link1="iiwa_left/iiwa_link_0" link2="iiwa_left/iiwa_link_1" reason="filtered" />
  <disable_collisions link1="iiwa_left/iiwa_link_0" link2="iiwa_left/iiwa_link_2" reason="filtered" />
  <disable_collisions link1="iiwa_left/iiwa_link_0" link2="iiwa_left/iiwa_link_3" reason="filtered" />
