  <disable_collisions link1="iiwa_right/iiwa_link_0" link2="iiwa_right/iiwa_link_3" reason="filtered" />
  <disable_collisions link1="iiwa_right/iiwa_link_1" link2="iiwa_right/iiwa_link_2" reason="filtered" />
  <disable_collisions link1="iiwa_right/iiwa_link_1" link2="iiwa_right/iiwa_link_3" reason="filtered" />
