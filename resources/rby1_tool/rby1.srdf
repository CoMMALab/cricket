<?xml version="1.0"?>
<!-- rby1: link pairs (both with collision geometry) whose collisions
     Drake filters: adjacent and welded bodies plus the models' and
     directives' collision filter groups. Every other pair is checked.
     tests/test_external_models.py checks it against the Drake model. -->
