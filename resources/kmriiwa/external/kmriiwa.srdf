<?xml version="1.0"?>
<!-- kmriiwa: link pairs (both with collision geometry) whose collisions
     Drake filters: adjacent and welded bodies plus the models' and
     directives' collision filter groups. Every other pair is checked.
     tests/test_external_models.py checks it against the Drake model. -->
<robot name="kmriiwa">
  <disable_collisions link1="kmr_base/kmriiwa_base_link" link2="iiwa/iiwa_link_0" reason="filtered" />
  <disable_collisions link1="kmr_base/kmriiwa_base_link" link2="iiwa/iiwa_link_1" reason="sphere_overlap" />
  <disable_collisions link1="iiwa/iiwa_link_0" link2="iiwa/iiwa_link_1" reason="filtered" />
  <disable_collisions link1="iiwa/iiwa_link_0" link2="iiwa/iiwa_link_2" reason="filtered" />
  <disable_collisions link1="iiwa/iiwa_link_0" link2="iiwa/iiwa_link_3" reason="filtered" />
  <disable_collisions link1="iiwa/iiwa_link_1" link2="iiwa/iiwa_link_2" reason="filtered" />
  <disable_collisions link1="iiwa/iiwa_link_1" link2="iiwa/iiwa_link_3" reason="filtered" />
  <disable_collisions link1="iiwa/iiwa_link_2" link2="iiwa/iiwa_link_3" reason="filtered" />
  <disable_collisions link1="iiwa/iiwa_link_3" link2="iiwa/iiwa_link_4" reason="filtered" />
  <disable_collisions link1="iiwa/iiwa_link_3" link2="iiwa/iiwa_link_5" reason="sphere_overlap" />
  <disable_collisions link1="iiwa/iiwa_link_4" link2="iiwa/iiwa_link_5" reason="filtered" />
  <disable_collisions link1="iiwa/iiwa_link_5" link2="wsg/body" reason="sphere_overlap" />
  <disable_collisions link1="iiwa/iiwa_link_4" link2="iiwa/iiwa_link_6" reason="filtered" />
  <disable_collisions link1="iiwa/iiwa_link_4" link2="iiwa/iiwa_link_7" reason="filtered" />
  <disable_collisions link1="iiwa/iiwa_link_5" link2="iiwa/iiwa_link_6" reason="filtered" />
  <disable_collisions link1="iiwa/iiwa_link_5" link2="iiwa/iiwa_link_7" reason="filtered" />
  <disable_collisions link1="iiwa/iiwa_link_6" link2="iiwa/iiwa_link_7" reason="filtered" />
  <disable_collisions link1="iiwa/iiwa_link_7" link2="wsg/body" reason="filtered" />
  <disable_collisions link1="iiwa/iiwa_link_7" link2="wsg/left_finger" reason="filtered" />
  <disable_collisions link1="iiwa/iiwa_link_7" link2="wsg/right_finger" reason="filtered" />
  <disable_collisions link1="wsg/body" link2="wsg/left_finger" reason="filtered" />
  <disable_collisions link1="wsg/body" link2="wsg/right_finger" reason="filtered" />
  <disable_collisions link1="wsg/left_finger" link2="wsg/right_finger" reason="filtered" />
</robot>
