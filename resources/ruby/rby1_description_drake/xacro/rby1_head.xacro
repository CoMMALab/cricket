<?xml version="1.0"?>
<!-- Direct xacro translation of head_with_mit_camera_mount.urdf. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rby1_head">

  <!--
    No ROS package available, so meshes are given as a plain relative path,
    rooted at models/, instead of package://. This string is copied
    verbatim into the mesh tags below (xacro does not resolve it), so
    whether it loads correctly depends on whatever consumes the generated
    URDF next:
      - Drake resolves relative mesh paths relative to the URDF file
        itself, so this works regardless of current working directory.
      - ROS tools built on resource_retriever (RViz, Gazebo classic via
        gazebo_ros) generally require a URI scheme (package://, file://,
        http(s)://) and will NOT resolve a bare relative path; you would
        need to run them from a directory where "ruby/rby1_description_drake/meshes"
        is reachable (e.g. launch from models/), or switch mesh_root to an
        absolute file:// URI at that point.
    Override at the xacro command line if this file moves relative to
    models/, e.g.: xacro ... mesh_root:=../../different/meshes
  -->
  <xacro:arg name="mesh_root" default="ruby/rby1_description_drake/meshes"/>
  <xacro:property name="mesh_dir" value="$(arg mesh_root)"/>

  <!-- Links -->

  <link name="link_head_base"/>

  <link name="link_head_0">
    <inertial>
      <mass value="0.07582110"/>
      <origin rpy="0 0 0" xyz="-0.00800549 0.0 -0.01100308"/>
      <inertia ixx="0.00003307" ixy="0.0" ixz="-0.00000290" iyy="0.00002209" iyz="0.0"
        izz="0.00003796"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/PAN_TILT_1.obj"/>
      </geometry>
    </visual>

    <!-- Conservative geometry to protect sensor head. -->
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.12"/>
      </geometry>
    </collision>
  </link>

  <link name="link_head_1">
    <inertial>
      <mass value="0.07450580"/>
      <origin rpy="0 0 0" xyz="-0.01150679 -0.00114270 -0.00031579"/>
      <inertia ixx="0.00001850" ixy="-0.00000035" ixz="0.00000203" iyy="0.00002451"
        iyz="-0.00000010" izz="0.00002062"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/PAN_TILT_2.obj"/>
      </geometry>
    </visual>
  </link>

  <link name="link_head_2">
    <inertial>
      <mass value="0.03585374"/>
      <origin rpy="0 0 0" xyz="-0.00081966 0.00099024 0.02283704"/>
      <inertia ixx="0.00002046" ixy="0.00000001" ixz="-0.00000027" iyy="0.00001044" iyz="0.00000076"
        izz="0.00001291"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/PAN_TILT_3.obj"/>
      </geometry>
    </visual>
  </link>

  <!-- BEGIN: Camera mount on MIT's RB-Y1 (Ruby) -->
  <link name="rby1_camera_mount">
    <visual>
      <geometry>
        <mesh filename="${mesh_dir}/rby1_camera_mount_realsense.obj"/>
      </geometry>
    </visual>
  </link>
  <!-- END: Camera mount on MIT's RB-Y1 (Ruby) -->

  <!-- Joints -->

  <joint name="head_base" type="fixed">
    <parent link="link_head_base"/>
    <child link="link_head_0"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.022 0.0 0.120073451525"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="head_0" type="revolute">
    <parent link="link_head_0"/>
    <child link="link_head_1"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.02"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000" velocity="3.14" lower="-0.523" upper="0.523"/>
  </joint>

  <joint name="head_1" type="revolute">
    <parent link="link_head_1"/>
    <child link="link_head_2"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" velocity="3.14" lower="-0.35" upper="1.57"/>
  </joint>

  <!-- BEGIN: Camera mount on MIT's RB-Y1 (Ruby) -->
  <joint name="head_mount" type="fixed">
    <parent link="link_head_2"/>
    <child link="rby1_camera_mount"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.04"/>
    <axis xyz="0 0 1"/>
  </joint>
  <!-- END: Camera mount on MIT's RB-Y1 (Ruby) -->

  <!-- Transmissions -->

  <transmission name="head_0_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="head_0">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="head_0_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="head_1_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="head_1">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="head_1_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!--
    Collision filters (informational only, no URDF equivalent):
    - "head": {link_head_base, link_head_1, link_head_2} all-pairs ignored
      (also used by the top-level assembly to filter against the torso and
      base).
  -->

</robot>
