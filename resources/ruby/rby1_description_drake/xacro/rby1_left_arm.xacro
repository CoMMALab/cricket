  <link name="ee_left"/>

  <!-- BEGIN: Wrist camera (RealSense), mounted on the FT sensor -->
  <link name="link_left_arm_camera">
    <visual>
      <origin xyz="0 .062 -0.038" rpy="0 0 3.14159"/>
      <geometry>
        <mesh filename="${mesh_dir}/rby1_wrist_camera.obj"/>
      </geometry>
    </visual>
    <!-- Simple primitive for collision, matching the rest of the arm. Tune size/origin to the camera envelope. -->
    <collision>
      <origin xyz="0 .062 -0.038" rpy="0 0 3.14159"/>
      <geometry>
        <box size="0.040 0.056 0.082"/>
      </geometry>
    </collision>
  </link>
  <!-- END: Wrist camera -->

  <!-- Joints -->

  <joint name="left_arm_0" type="revolute">
    <parent link="link_left_arm_base"/>
    <child link="link_left_arm_0"/>
    <origin rpy="0.349065850  0.0 0.0" xyz="0.0 0.220 0.080073452 "/>
    <axis xyz="0 1 0"/>
    <limit effort="1000.0" lower="-2.35619449" upper="2.35619449" velocity="3.14159265"/>
  </joint>

  <joint name="left_arm_1" type="revolute">
    <parent link="link_left_arm_0"/>
    <child link="link_left_arm_1"/>
    <origin rpy="-0.349065850 0.0 0.0" xyz="0.0 0.0 0.0"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000.0" lower="-0.05" upper="3.14159265" velocity="3.14159265"/>
  </joint>

  <joint name="left_arm_2" type="revolute">
    <parent link="link_left_arm_1"/>
    <child link="link_left_arm_2"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.09439510" upper="2.09439510" velocity="3.14159265"/>
  </joint>

  <joint name="left_arm_3" type="revolute">
    <parent link="link_left_arm_2"/>
    <child link="link_left_arm_3"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.031 0.0 -0.276"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000.0" lower="-2.61799388" upper="0.01" velocity="3.14159265"/>
  </joint>

  <joint name="left_arm_4" type="revolute">
    <parent link="link_left_arm_3"/>
    <child link="link_left_arm_4"/>
    <origin rpy="0.0 0.0 0.0" xyz="-0.031 0.0 -0.256"/>
    <axis xyz="0 0 1"/>
    <!-- Reduced from full +-2pi range for camera wires. -->
    <limit effort="1000.0" lower="-3.0" upper="3.0" velocity="3.14159265"/>
  </joint>

  <joint name="left_arm_5" type="revolute">
    <parent link="link_left_arm_4"/>
    <child link="link_left_arm_5"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000.0" lower="-1.74532925" upper="2.00712864" velocity="30.14159265"/>
  </joint>

  <joint name="left_arm_6" type="revolute">
    <parent link="link_left_arm_5"/>
    <child link="link_left_arm_6"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.75" upper="2.75" velocity="3.14159265"/>
  </joint>

  <joint name="tool_left" type="fixed">
    <parent link="link_left_arm_6"/>
    <child link="FT_sensor_L"/>
    <origin rpy="0.0 0.0 0" xyz="0.0 0.0 -0.1087"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="FT_Sensor_END_left" type="fixed">
    <parent link="FT_sensor_L"/>
    <child link="ee_left"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.0461"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- BEGIN: Wrist camera mount. -->
  <joint name="left_arm_camera_mount" type="fixed">
    <parent link="FT_sensor_L"/>
    <child link="link_left_arm_camera"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <!-- END: Wrist camera mount -->

  <!-- Transmissions -->

  <transmission name="left_arm_0_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_arm_0">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_arm_0_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
