  <joint name="right_arm_6" type="revolute">
    <parent link="link_right_arm_5"/>
    <child link="link_right_arm_6"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.75" upper="2.75" velocity="3.14159265"/>
  </joint>

  <joint name="tool_right" type="fixed">
    <parent link="link_right_arm_6"/>
    <child link="FT_sensor_R"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.1087"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="FT_Sensor_END_right" type="fixed">
    <parent link="FT_sensor_R"/>
    <child link="ee_right"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.0461"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- BEGIN: Wrist camera mount. -->
  <joint name="right_arm_camera_mount" type="fixed">
    <parent link="FT_sensor_R"/>
    <child link="link_right_arm_camera"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <!-- END: Wrist camera mount -->

  <!-- Transmissions -->

  <transmission name="right_arm_0_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_arm_0">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_arm_0_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
