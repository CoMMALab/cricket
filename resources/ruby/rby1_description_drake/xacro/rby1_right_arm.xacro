<?xml version="1.0"?>
<!-- Direct xacro translation of right_arm.urdf. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rby1_right_arm">

  <!--
    No ROS package available, so meshes are given as a plain relative path,
    rooted at models/, instead of package://. This string is copied
    verbatim into the mesh tags below (xacro does not resolve it), so
    whether it loads correctly depends on whatever consumes the generated
    URDF next:
      - Drake resolves relative mesh paths relative to the URDF file
        itself, so this works regardless of current working directory.
      - ROS tools built on resource_retriever (RViz, Gazebo classic via
        gazebo_ros) generally require a URI scheme (package://, file://,
        http(s)://) and will NOT resolve a bare relative path; you would
        need to run them from a directory where "ruby/rby1_description_drake/meshes"
        is reachable (e.g. launch from models/), or switch mesh_root to an
        absolute file:// URI at that point.
    Override at the xacro command line if this file moves relative to
    models/, e.g.: xacro ... mesh_root:=../../different/meshes
  -->
  <xacro:arg name="mesh_root" default="ruby/rby1_description_drake/meshes"/>
  <xacro:property name="mesh_dir" value="$(arg mesh_root)"/>

  <!-- Links -->

  <link name="link_right_arm_base"/>

