  <!--
    Collision filters (informational only, no URDF equivalent):
    - "upper_arm": {link_right_arm_0, link_right_arm_1, link_right_arm_2}
      (used by the top-level assembly to filter against the torso).
    - "main_arm": {link_right_arm_0..5} all-pairs ignored.
    - "lower_arm": {link_right_arm_3..6, FT_sensor_R, ee_right,
      link_right_arm_camera} all-pairs ignored (also used by the top-level
      assembly to filter against the gripper).
  -->

</robot>
