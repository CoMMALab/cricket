<?xml version="1.0"?>
<!--
  Direct xacro translation of base_holonomic_with_actuators.urdf.
  Root of the whole robot: a planar/holonomic floating base built from a
  world -> base_x (prismatic) -> base_y (prismatic) -> base_z (fixed) ->
  base_rz (continuous) chain, matching the original Drake URDF.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rby1_base_holonomic">

  <!--
    No ROS package available, so meshes are given as a plain relative path,
    rooted at models/, instead of package://. This string is copied
    verbatim into the mesh tags below (xacro does not resolve it), so
    whether it loads correctly depends on whatever consumes the generated
    URDF next:
      - Drake resolves relative mesh paths relative to the URDF file
        itself, so this works regardless of current working directory.
      - ROS tools built on resource_retriever (RViz, Gazebo classic via
        gazebo_ros) generally require a URI scheme (package://, file://,
        http(s)://) and will NOT resolve a bare relative path; you would
        need to run them from a directory where "ruby/rby1_description_drake/meshes"
        is reachable (e.g. launch from models/), or switch mesh_root to an
        absolute file:// URI at that point.
    Override at the xacro command line if this file moves relative to
    models/, e.g.: xacro ... mesh_root:=../../different/meshes
  -->
  <xacro:arg name="mesh_root" default="ruby/rby1_description_drake/meshes"/>
  <xacro:property name="mesh_dir" value="$(arg mesh_root)"/>

  <!-- Root of the kinematic tree that the floating base joints hang off of. -->
  <link name="world"/>

  <!-- Links -->

  <link name="base_x"/>
  <link name="base_y"/>
  <link name="base_z"/>

  <link name="base">
    <inertial>
      <mass value="60.08042639"/>
      <origin rpy="0 0 0" xyz="-0.06157942 -0.00142271 0.13513861"/>
      <inertia ixx="1.37742174" ixy="0.02521789" ixz="0.18565467" iyy="2.99386515" iyz="-0.00641869"
        izz="3.76085052"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/BASE.obj"/>
      </geometry>
    </visual>

    <!-- Front axle area -->
    <collision>
      <origin xyz="0.23 0.175 0.13" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.23 0.075 0.125" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.23 0 0.125" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.23 -0.075 0.125" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.23 -0.175 0.13" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
    </collision>

    <!-- Lidars -->
    <collision>
      <origin xyz="0.225 0.1725 0.24" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.225 -0.1725 0.24" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>

    <!-- Mid/rear body -->
    <collision>
      <origin xyz="0.12 0.175 0.11" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.12 -0.175 0.11" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>

    <collision>
      <origin xyz="0.01 0.175 0.11" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.01 -0.175 0.11" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>

    <collision>
      <origin xyz="-0.1 0.175 0.11" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.1 -0.175 0.11" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>

    <collision>
      <origin xyz="-0.2 0.15 0.11" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.2 -0.15 0.11" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>

    <collision>
      <origin xyz="-0.28 0.12 0.11" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.28 0.04 0.11" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.28 -0.04 0.11" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.28 -0.12 0.11" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_r">
    <inertial>
      <mass value="1.37783736"/>
      <origin rpy="0 0 0" xyz="0.0 -0.00073938 0.0"/>
      <inertia ixx="0.00426657" ixy="0.0" ixz="0.0" iyy="0.00811815" iyz="0.0" izz="0.00426657"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/WHEEL.obj"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_l">
    <inertial>
      <mass value="1.37783736"/>
      <origin rpy="0 0 0" xyz="0.0 0.00073938 0.0"/>
      <inertia ixx="0.00426657" ixy="0.0" ixz="0.0" iyy="0.00811815" iyz="0.0" izz="0.00426657"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/WHEEL.obj"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
    </collision>
  </link>

  <link name="torso_mount"/>

  <!-- BEGIN: Mid-360 lidar near the front of the base -->
  <link name="lidar_mid360">
    <visual>
      <origin xyz="-0.018 0 0.015" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/mid-360.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.018 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.073 0.060 0.065"/>
      </geometry>
    </collision>
  </link>
  <!-- END: Mid-360 lidar -->

  <!-- Joints -->

  <!-- Floating base: 2 prismatic (x, y) + 1 fixed (z) + 1 continuous (yaw) -->
  <joint name="base_x" type="prismatic">
    <parent link="world"/>
    <child link="base_x"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" lower="-1000" upper="1000" velocity="1000.00"/>
  </joint>
  <joint name="base_y" type="prismatic">
    <parent link="base_x"/>
    <child link="base_y"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" lower="-1000" upper="1000" velocity="1000.00"/>
  </joint>
  <joint name="base_z" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base_y"/>
    <child link="base_z"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="base_rz" type="continuous">
    <parent link="base_z"/>
    <child link="base"/>
    <axis xyz="0 0 1"/>
  </joint>

  <transmission name="base_x_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="base_x">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="base_x_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="base_y_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="base_y">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="base_y_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="base_rz_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="base_rz">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="base_rz_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <joint name="right_wheel" type="fixed">
    <parent link="base"/>
    <child link="wheel_r"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.228 -0.265 0.1"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="left_wheel" type="fixed">
    <parent link="base"/>
    <child link="wheel_l"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.228 0.265 0.1"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="torso_mount" type="fixed">
    <parent link="base"/>
    <child link="torso_mount"/>
    <origin rpy="0.0 0.0 0.0" xyz="-0.247 0.0 0.168"/>
  </joint>

  <joint name="lidar_mid360_mount" type="fixed">
    <parent link="base"/>
    <child link="lidar_mid360"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.25 0.0 0.2"/>
  </joint>

  <!--
    Collision filters (informational only): the original Drake URDF disabled
    collisions within this group via <drake:collision_filter_group name="base">
    { base, wheel_l, wheel_r, lidar_mid360 }. Drake's collision filter groups
    have no ROS/URDF equivalent; if you need the same behavior under MoveIt,
    add matching <disable_collisions> entries to the SRDF instead.
  -->

</robot>
